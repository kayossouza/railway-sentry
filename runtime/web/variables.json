{
  "COMPOSE_PROFILES": "feature-complete",
  "SENTRY_EVENT_RETENTION_DAYS": "7",
  "SENTRY_SYSTEM_SECRET_KEY": "${{secret(64)}}",
  "POSTGRES_HOST": "${{postgres.RAILWAY_PRIVATE_DOMAIN}}",
  "POSTGRES_PASSWORD": "${{postgres.POSTGRES_PASSWORD}}",
  "REDIS_HOST": "${{valkey.RAILWAY_PRIVATE_DOMAIN}}",
  "REDIS_PASSWORD": "${{valkey.REDIS_PASSWORD}}",
  "MEMCACHED_HOST": "${{memcached.RAILWAY_PRIVATE_DOMAIN}}",
  "KAFKA_BROKERS": "${{kafka.RAILWAY_PRIVATE_DOMAIN}}:9092",
  "SNUBA": "http://${{snuba-api.RAILWAY_PRIVATE_DOMAIN}}:1218",
  "WEB_URL": "http://${{web.RAILWAY_PRIVATE_DOMAIN}}:9000",
  "SYMBOLICATOR_HOST": "${{symbolicator.RAILWAY_PRIVATE_DOMAIN}}",
  "TASKBROKER_HOST": "${{taskbroker.RAILWAY_PRIVATE_DOMAIN}}",
  "PUBLIC_URL": "https://${{gateway.RAILWAY_PUBLIC_DOMAIN}}",
  "NODE_ENDPOINT": "${{Nodestore.ENDPOINT}}",
  "NODE_BUCKET": "${{Nodestore.BUCKET}}",
  "NODE_REGION": "${{Nodestore.REGION}}",
  "NODE_ACCESS_KEY": "${{Nodestore.ACCESS_KEY_ID}}",
  "NODE_SECRET_KEY": "${{Nodestore.SECRET_ACCESS_KEY}}",
  "FILE_ENDPOINT": "${{Filestore.ENDPOINT}}",
  "FILE_BUCKET": "${{Filestore.BUCKET}}",
  "FILE_REGION": "${{Filestore.REGION}}",
  "FILE_ACCESS_KEY": "${{Filestore.ACCESS_KEY_ID}}",
  "FILE_SECRET_KEY": "${{Filestore.SECRET_ACCESS_KEY}}",
  "PORT": "9000",
  "WEB_WORKERS": "1",
  "ADMIN_EMAIL": "admin@sentry.local",
  "ADMIN_PASSWORD": "${{secret(32)}}",
  "RAILWAY_DOCKERFILE_PATH": "web/Dockerfile",
  "RAILWAY_HEALTHCHECK_TIMEOUT_SEC": "900",
  "INGESTION_URL": "http://${{gateway.RAILWAY_PRIVATE_DOMAIN}}:8081"
}
