{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "relay/Dockerfile"
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "numReplicas": 1,
    "healthcheckPath": "/api/relay/healthcheck/ready/",
    "healthcheckTimeout": 900,
    "overlapSeconds": 0
  }
}
